{
  "name": "super-chino",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @super-chino/web build",
    "start": "pnpm --filter @super-chino/api start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @super-chino/api db:migrate",
    "db:deploy": "pnpm --filter @super-chino/api db:deploy",
    "db:seed": "pnpm --filter @super-chino/api db:seed",
    "e2e": "pnpm --filter @super-chino/web e2e",
    "almacen:dev": "pnpm --parallel --filter ./almacen/api --filter ./almacen/web dev",
    "almacen:build": "pnpm --filter @almacen/web build",
    "almacen:test": "pnpm --filter \"./almacen/*\" test",
    "almacen:e2e": "pnpm --filter @almacen/web e2e",
    "almacen:db:migrate": "pnpm --filter @almacen/api db:migrate",
    "almacen:db:seed": "pnpm --filter @almacen/api db:seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
