# Copiá este archivo como .env y completalo. El .env nunca se sube al repo.

# paper = simulación con dinero virtual (empezá por acá); live = dinero real.
MODE=paper

# Clave de la API de Anthropic para los agentes (console.anthropic.com).
# Ojo: la simulación también la usa y gasta de verdad.
ANTHROPIC_API_KEY=
# Tope de gasto diario en IA. Al llegar, no hay entradas nuevas hasta el día siguiente (UTC).
LLM_DAILY_BUDGET_USD=20

# Objetivo final y metas. En cada meta se retira WITHDRAW_PCT% de la ganancia hecha desde el último retiro.
TARGET_USD=2000000
MILESTONES_USD=100000,300000,600000,1000000,1500000
WITHDRAW_PCT=50
# Billetera segura TUYA (distinta de la del bot) donde llegan los retiros. Obligatoria en modo real.
WITHDRAW_ADDRESS=
# Quiebra: si el capital del bot cae por debajo de esto, vende lo que quede y se apaga para siempre.
BUST_USD=10

# Capital virtual de la simulación.
PAPER_START_USD=1000

# RPC de Solana. El público alcanza para probar; para operar en real usá uno propio (Helius tiene plan gratis).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solo para MODE=live: clave privada de una billetera NUEVA y exclusiva del bot (base58 o arreglo JSON).
# Cargala con los USDC que vas a arriesgar y unos 0,1 SOL para comisiones.
WALLET_PRIVATE_KEY=

# Jupiter (compras y ventas). Si pide clave, sacala gratis en portal.jup.ag y usá JUP_API_URL=https://api.jup.ag
JUP_API_URL=https://lite-api.jup.ag
JUP_API_KEY=

# Avisos por Telegram (opcional): creá un bot con @BotFather y poné tu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Agentes (valores por defecto) ---
# DIRECTOR_MODEL=claude-opus-5
# QUANT_MODEL=claude-sonnet-5
# RISK_MODEL=claude-sonnet-5
# DIRECTOR_EFFORT=medium
# DIRECTOR_MINUTES=15
# MAX_CANDIDATES=10
# MAX_THESES=3

# --- Topes duros de riesgo: ningún agente los puede pasar ---
# Muchas apuestas chicas: la mayoría pierde poco y unas pocas ganadoras pagan todo.
# MAX_POSITIONS=8
# MAX_POSITION_PCT=5
# MAX_POOL_FRACTION=0.02
# MAX_PRICE_IMPACT_PCT=2
# STOP_LOSS_MIN_PCT=5
# STOP_LOSS_MAX_PCT=40
# Al subir TAKE_PROFIT_PCT vende la mitad; el resto corre con un stop dinámico entre estos topes.
# TAKE_PROFIT_PCT=100
# TRAILING_STOP_MIN_PCT=15
# TRAILING_STOP_MAX_PCT=60
# MAX_HOLD_MINUTES=1440
# LOSS_STREAK_PAUSE=4
# PAUSE_MINUTES=60

# --- Aprendizaje ---
# Horas que sigue a cada moneda vista y cada cuánto el director revisa y escribe lecciones.
# OBSERVE_HOURS=24
# REVIEW_HOURS=24
# Desde qué múltiplo una moneda cuenta como ganadora.
# WINNER_MULTIPLE=3
# MIN_REVIEW_OBSERVATIONS=20
# MAX_LESSONS=10

# La lista completa está en memebot/config.py.
