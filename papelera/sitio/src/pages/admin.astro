---
// Panel administrativo oculto: no está enlazado, no se indexa y solo guarda con un token de GitHub.
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "../styles/global.css";
import negocio from "../datos/negocio.json";
import productos from "../datos/productos.json";
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel · {negocio.nombre}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="admin">
  <header class="barra">
    <div class="barra__in admin-barra-sup">
      <p class="logo__nombre" style="color:#fff">{negocio.nombre} <span class="admin-etq">Panel</span></p>
      <p class="admin-estado" id="estado-conexion">Sin entrar</p>
      <button class="btn-texto admin-salir" type="button" id="salir" hidden>Salir</button>
    </div>
  </header>

  <main class="envoltura admin-main">
    <section class="admin-caja" id="conexion">
      <div class="admin-conexion">
        <div>
          <h1 class="titular titular--chico">Entrar</h1>
          <p class="bajada" style="font-size:.95rem;margin-top:.4rem">Los cambios se publican en la web en uno o dos minutos. Antes podés verlos en una vista previa.</p>
        </div>
        <form class="formulario" id="form-conexion" autocomplete="on">
          <input type="text" name="usuario" value="panel" autocomplete="username" hidden />
          <label for="c-clave">Contraseña<input id="c-clave" name="clave" type="password" autocomplete="current-password" /></label>
          <p class="formulario__error" id="c-error" hidden></p>
          <div style="display:flex;flex-wrap:wrap;gap:.6rem">
            <button class="btn btn--tinta" type="submit" id="entrar">Entrar</button>
            <button class="btn btn--linea" type="button" id="modo-prueba">Modo prueba (sin guardar)</button>
          </div>
          <details class="admin-ayuda">
            <summary>¿Primera vez? Cómo se configura</summary>
            <ol>
              <li>La web tiene que estar publicada en <b>Cloudflare Pages</b> (el panel guarda a través de Cloudflare).</li>
              <li>En GitHub creá un token: <b>Settings → Developer settings → Fine-grained tokens</b>, solo para el repositorio de la web, con permiso <b>Contents: Read and write</b>.</li>
              <li>En Cloudflare, en el proyecto: <b>Settings → Variables and Secrets</b>, cargá <code>ADMIN_CLAVE</code> (tu contraseña), <code>SESION_SECRETO</code> (una frase larga cualquiera) y <code>GITHUB_TOKEN</code> (el token). Opcional: <code>VISTA_PREVIA_URL</code>.</li>
              <li>Volvé a publicar el proyecto y entrá acá con tu contraseña.</li>
            </ol>
          </details>
        </form>
      </div>
    </section>

    <section id="panel" hidden>
      <nav class="admin-tabs" role="tablist" aria-label="Secciones del panel">
        <button role="tab" type="button" data-tab="precios" aria-selected="true">Precios y stock</button>
        <button role="tab" type="button" data-tab="pdf" aria-selected="false">Lista nueva</button>
        <button role="tab" type="button" data-tab="negocio" aria-selected="false">Negocio</button>
        <button role="tab" type="button" data-tab="kits" aria-selected="false">Kits</button>
        <button role="tab" type="button" data-tab="qr" aria-selected="false">QR</button>
        <button role="tab" type="button" data-tab="historial" aria-selected="false">Historial</button>
        <button role="tab" type="button" data-tab="avanzado" aria-selected="false">Avanzado</button>
      </nav>
      <div id="contenido-tab" class="admin-caja"></div>
    </section>
  </main>

  <div class="admin-pie" id="pie" hidden>
    <p id="resumen-cambios">Sin cambios</p>
    <div class="admin-pie__botones">
      <button class="btn btn--linea" type="button" id="descartar">Descartar</button>
      <button class="btn btn--linea" type="button" id="vista-previa">Vista previa</button>
      <button class="btn btn--cinta" type="button" id="publicar">Publicar</button>
    </div>
  </div>

  <dialog class="admin-dialogo" id="dialogo">
    <div class="admin-dialogo__cabeza"><h2 id="dialogo-titulo">Resultado</h2><button class="cerrar" type="button" id="dialogo-cerrar" aria-label="Cerrar">×</button></div>
    <div id="dialogo-html" class="admin-dialogo__html" hidden></div>
    <pre id="dialogo-texto"></pre>
  </dialog>
  <div class="aviso" id="aviso" role="status" aria-live="polite"><span id="aviso-texto"></span></div>

  <script type="application/json" id="datos-admin" set:html={JSON.stringify({ negocio, productos })} />
  <script>
    import "../scripts/admin.ts";
  </script>
</body>
</html>

<style is:global>
  .admin { background: var(--papel); padding-bottom: 6rem; }
  .admin-etq { font-family: var(--f-dato); font-stretch: 100%; font-size: .7rem; font-weight: 600; background: var(--cinta); color: var(--sobre-cinta); padding: .15rem .45rem; border-radius: 3px; vertical-align: middle; margin-left: .4rem; letter-spacing: .06em; }
  .admin-estado { margin-left: auto; font-size: .85rem; opacity: .85; }
  .admin-main { padding-block: 1.5rem; display: grid; gap: 1rem; }
  .admin-main > * { min-width: 0; }
  .admin-caja { background: var(--superficie); border: 1px solid var(--linea); border-radius: var(--radio); padding: clamp(1rem, 3vw, 1.6rem); min-width: 0; }
  .admin-conexion { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2rem; }
  .admin-ayuda { font-size: .88rem; color: var(--tenue); }
  .admin-ayuda summary { cursor: pointer; font-weight: 600; color: var(--tinta); }
  .admin-ayuda ol { padding-left: 1.2rem; display: grid; gap: .35rem; margin-top: .6rem; }
  .admin-tabs { display: flex; gap: .3rem; overflow-x: auto; scrollbar-width: none; }
  .admin-tabs button { flex: none; font: 600 .9rem var(--f-cuerpo); padding: .7rem 1rem; border: 1px solid var(--linea); border-bottom: 0; border-radius: var(--radio) var(--radio) 0 0; background: var(--papel); color: var(--tenue); cursor: pointer; }
  .admin-tabs button[aria-selected="true"] { background: var(--superficie); color: var(--tinta); box-shadow: inset 0 3px 0 var(--cobalto); }
  #panel .admin-caja { border-top-left-radius: 0; }
  .admin-barra { display: flex; flex-wrap: wrap; gap: .6rem; align-items: end; margin-bottom: 1rem; }
  .admin-barra label { display: grid; gap: .25rem; font-size: .8rem; font-weight: 600; color: var(--tenue); }
  .admin input, .admin select, .admin textarea { font: 500 .92rem var(--f-cuerpo); color: var(--tinta); background: var(--papel); border: 1px solid var(--linea); border-radius: 4px; padding: .5rem .6rem; }
  .admin input:focus, .admin select:focus, .admin textarea:focus { outline: 2px solid var(--cobalto); outline-offset: 0; border-color: transparent; }
  .admin input[type="number"] { font-family: var(--f-dato); text-align: right; }
  .admin-masivo { display: flex; flex-wrap: wrap; gap: .6rem; align-items: end; background: var(--papel); border: 1px dashed var(--linea); border-radius: var(--radio); padding: .9rem; margin-bottom: 1rem; }
  .admin-masivo label { display: grid; gap: .25rem; font-size: .8rem; font-weight: 600; color: var(--tenue); }
  .admin-masivo p { flex-basis: 100%; font-size: .88rem; }
  .admin-tabla-env { overflow-x: auto; }
  .admin-tabla { width: 100%; border-collapse: collapse; font-size: .88rem; }
  .admin-tabla th { text-align: left; font-family: var(--f-dato); font-weight: 400; font-size: .68rem; letter-spacing: .08em; text-transform: uppercase; color: var(--tenue); padding: .5rem .5rem .5rem 0; border-bottom: 2px solid var(--tinta); white-space: nowrap; }
  .admin-tabla td { padding: .35rem .5rem .35rem 0; border-bottom: 1px solid var(--linea); vertical-align: middle; }
  .admin-tabla td.cod { font-family: var(--f-dato); font-size: .78rem; color: var(--tenue); white-space: nowrap; }
  .admin-tabla input[type="number"] { width: 7.5rem; }
  .admin-tabla tr.cambiado td { background: var(--ok-fondo); }
  .admin-tabla tr.nuevo td { background: #fff6d6; }
  .admin-tabla .quitar { font-size: 1.1rem; }
  .admin-grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .9rem 1.2rem; }
  .admin-grilla label { display: grid; gap: .3rem; font-size: .85rem; font-weight: 600; }
  .admin-grilla small, .admin-nota { font-weight: 400; color: var(--tenue); font-size: .82rem; }
  .admin h2 { font-family: var(--f-display); font-stretch: 72%; font-weight: 820; text-transform: uppercase; font-size: 1.4rem; margin: 1.6rem 0 .8rem; }
  .admin h2:first-child { margin-top: 0; }
  .admin-kit { border: 1px solid var(--linea); border-radius: var(--radio); padding: 1rem; margin-bottom: 1rem; display: grid; gap: .8rem; }
  .admin-cambios { display: grid; gap: .3rem; font-size: .9rem; }
  .admin .mas { color: var(--ok); } .admin .menos { color: var(--error); } .admin .m { font-family: var(--f-dato); white-space: nowrap; }
  .admin-pie { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .8rem; padding: .8rem var(--canal) calc(.8rem + env(safe-area-inset-bottom, 0px)); background: var(--carbon); color: var(--sobre-carbon); }
  .admin-pie .btn--linea { border-color: rgba(255,255,255,.5); color: var(--sobre-carbon); }
  .admin-pie .btn--linea:hover { background: var(--sobre-carbon); color: var(--carbon); }
  .admin-pie .btn { padding: .7rem 1rem; }
  .admin-dialogo { width: min(52rem, calc(100% - 2rem)); max-height: 85vh; border: 0; border-radius: var(--radio); padding: 0; background: var(--superficie); color: var(--tinta); box-shadow: var(--sombra); }
  .admin-dialogo::backdrop { background: rgba(8, 10, 20, .55); }
  .admin-dialogo__cabeza { display: flex; justify-content: space-between; align-items: center; padding: .9rem 1.1rem; border-bottom: 2px solid var(--tinta); }
  .admin-dialogo__cabeza h2 { margin: 0; }
  .admin-dialogo pre { margin: 0; padding: 1rem 1.1rem; overflow: auto; max-height: 70vh; font: .78rem/1.5 var(--f-dato); white-space: pre-wrap; }
  .admin-barra-sup { flex-wrap: wrap; gap: .3rem 1rem; }
  .admin-salir { color: #fff; font-size: .85rem; }
  .admin-pie__botones { display: flex; gap: .5rem; flex-wrap: wrap; }
  .admin-dialogo__html { padding: 1rem 1.1rem; display: grid; gap: .7rem; }
  .admin-dialogo__html a { color: var(--cobalto); font-weight: 650; word-break: break-all; }
  .admin-filtros { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: .9rem; }
  .admin-oferta { display: flex; gap: .35rem; align-items: center; flex-wrap: wrap; }
  .admin-oferta input[type="number"] { width: 4.6rem; }
  .admin-oferta input[type="date"] { width: 9.5rem; }
  .admin-tabla select { max-width: 9rem; }
  .admin-tabla .sub { display: block; font-size: .74rem; color: var(--tenue); margin-top: .2rem; }
  .admin-historial { list-style: none; padding: 0; display: grid; }
  .admin-historial li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .3rem 1rem; align-items: center; padding: .8rem 0; border-bottom: 1px solid var(--linea); }
  .admin-historial small { color: var(--tenue); font-family: var(--f-dato); font-size: .75rem; }
  .admin-tabla tr.estado-sin-stock td.cod { color: var(--error); }
  .admin-grilla label { display: flex; flex-direction: column; justify-content: flex-end; }
  @media (max-width: 820px) {
    .admin-tabs { flex-wrap: wrap; overflow: visible; gap: .35rem; margin-bottom: .6rem; }
    .admin-tabs button { border: 1px solid var(--linea); border-radius: 999px; padding: .5rem .85rem; font-size: .84rem; }
    .admin-tabs button[aria-selected="true"] { box-shadow: none; background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
    #panel .admin-caja { border-top-left-radius: var(--radio); }
    .admin-masivo > *, .admin-barra > * { flex: 1 1 100%; }
    .admin-masivo select, .admin-masivo input, .admin-barra select, .admin-barra input { width: 100% !important; }
    .admin-tabla--precios thead { display: none; }
    .admin-tabla--precios, .admin-tabla--precios tbody { display: block; }
    .admin-tabla--precios tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: .55rem .7rem; padding: .9rem 0; border-bottom: 1px solid var(--linea); }
    .admin-tabla--precios td { display: grid; gap: .25rem; padding: 0; border: 0; min-width: 0; align-content: start; }
    .admin-historial li { grid-template-columns: minmax(0, 1fr); }
    .admin-historial li .btn { justify-self: start; }
    .admin-tabla--precios td[data-et]::before { content: attr(data-et); font: .66rem var(--f-dato); text-transform: uppercase; letter-spacing: .06em; color: var(--tenue); }
    .admin-tabla--precios td.ancho { grid-column: 1 / -1; }
    .admin-tabla--precios td.fin { justify-items: end; }
    .admin-tabla--precios input { width: 100% !important; min-width: 0 !important; }
    .admin-tabla--precios select { max-width: none; width: 100%; }
    .admin-tabla--precios tr.cambiado, .admin-tabla--precios tr.nuevo { background: var(--ok-fondo); }
    .admin-tabla--precios tr.cambiado td, .admin-tabla--precios tr.nuevo td { background: none; }
    .admin-pie { padding-block: .6rem; gap: .5rem; }
    .admin-pie p { font-size: .8rem; flex-basis: 100%; }
    .admin-pie__botones { width: 100%; }
    .admin-pie__botones .btn { flex: 1; padding: .65rem .5rem; font-size: .88rem; }
  }
  @media (max-width: 820px) { .admin-conexion { grid-template-columns: minmax(0, 1fr); gap: 1rem; } }
</style>
