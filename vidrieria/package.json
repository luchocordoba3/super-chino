{
  "name": "lumina-vidrieria",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @vidrieria/web build",
    "start": "pnpm --filter @vidrieria/api start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @vidrieria/api db:migrate",
    "db:deploy": "pnpm --filter @vidrieria/api db:deploy",
    "db:seed": "pnpm --filter @vidrieria/api db:seed",
    "e2e": "pnpm --filter @vidrieria/web e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild"]
  }
}
