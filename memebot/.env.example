# Copiá este archivo como .env y completalo. El .env nunca se sube al repo.

# paper = simulación con dinero virtual (empezá por acá); live = dinero real.
MODE=paper

# Meta: al llegar, vende todo a USDC y deja de operar para siempre.
TARGET_USD=100000
# Quiebra: con menos capital que esto, vende lo que quede y se apaga para siempre.
BUST_USD=10

# Capital virtual de la simulación.
PAPER_START_USD=100

# RPC de Solana. El público alcanza para probar; para operar en real usá uno propio (Helius tiene plan gratis).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solo para MODE=live: clave privada de una billetera NUEVA y exclusiva del bot (base58 o arreglo JSON).
# Cargala con los USDC que vas a arriesgar y unos 0,1 SOL para comisiones.
WALLET_PRIVATE_KEY=

# Jupiter (compras y ventas). Si pide clave, sacala gratis en portal.jup.ag y usá JUP_API_URL=https://api.jup.ag
JUP_API_URL=https://lite-api.jup.ag
JUP_API_KEY=

# Avisos por Telegram (opcional): creá un bot con @BotFather y poné tu chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

