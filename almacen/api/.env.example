DATABASE_URL=postgresql://almacen:almacen@localhost:5432/almacen
TEST_DATABASE_URL=postgresql://almacen:almacen@localhost:5432/almacen_test
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
PORT=3200
# IA (opcional). Sin clave la app funciona igual, sin traducción ni lectura de fotos.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
# Notificaciones push (opcional). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
UPLOAD_DIR=./uploads
# Dirección pública de la app (para volver de Mercado Pago y para sus avisos). Ej. https://almacen.onrender.com
PUBLIC_URL=
# Mercado Pago (opcional). Con MP_CLIENT_ID y MP_CLIENT_SECRET aparece "Conectar Mercado Pago";
# sin ellos, cada dueño puede pegar el Access Token de su cuenta.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta del webhook (tópico Order) para validar la firma de los avisos de pago.
MP_WEBHOOK_SECRET=
# Clave para guardar cifradas las credenciales de terceros. Si falta, se usa JWT_SECRET.
SECRETS_KEY=
