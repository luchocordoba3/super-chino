---
import { ruta } from "../lib/catalogo";
---
<div class="barra-total" id="barra-total" hidden>
  <div>
    <span class="barra-total__n" data-pedido="resumen"></span>
    <strong class="barra-total__monto" data-pedido="total"></strong>
  </div>
  <button class="btn" type="button" data-abrir-pedido>Ver pedido</button>
</div>

<div class="velo" id="velo" hidden></div>
<aside class="pedido" id="pedido" aria-labelledby="pedido-titulo" aria-hidden="true" tabindex="-1">
  <div class="remito">
    <header class="remito__cabeza">
      <div>
        <p class="remito__tipo">Nota de pedido</p>
        <h2 id="pedido-titulo" class="remito__numero">N.º <span id="remito-numero"></span></h2>
      </div>
      <div class="remito__fecha" id="remito-fecha"></div>
      <button class="cerrar" type="button" id="cerrar-pedido" aria-label="Cerrar pedido">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </header>

    <div class="remito__cuerpo">
      <div class="umbral" data-pedido="umbral" hidden>
        <p class="umbral__texto" data-pedido="umbral-texto"></p>
        <div class="umbral__barra"><span data-pedido="umbral-barra"></span></div>
      </div>

      <div class="remito__vacio" id="remito-vacio">
        <p><strong>Tu pedido está vacío.</strong></p>
        <p>Cargá cantidades en la lista de precios, sumá un kit o pegá tu lista en el pedido rápido.</p>
        <a class="flecha" href={ruta("lista")}>Ir a la lista de precios →</a>
      </div>

      <table class="lineas" id="lineas" hidden>
        <thead>
          <tr><th scope="col" class="num">Cant.</th><th scope="col">Artículo</th><th scope="col" class="num">Importe</th><th scope="col"><span class="visualmente-oculto">Quitar</span></th></tr>
        </thead>
        <tbody id="lineas-cuerpo"></tbody>
      </table>

      <dl class="totales" id="totales" hidden>
        <div><dt>Subtotal <span data-pedido="tipo"></span></dt><dd data-pedido="total"></dd></div>
        <div><dt>Envío</dt><dd data-pedido="envio"></dd></div>
        <div class="totales__final"><dt>Total</dt><dd data-pedido="total"></dd></div>
        <div class="totales__ahorro" data-pedido="ahorro-fila" hidden><dt>Ahorro por mayor</dt><dd data-pedido="ahorro"></dd></div>
      </dl>

      <form class="formulario datos-entrega" id="datos-entrega" novalidate hidden>
        <p class="remito__tipo">Datos para la entrega</p>
        <label for="d-negocio">Negocio o nombre<input id="d-negocio" name="negocio" required autocomplete="organization" /></label>
        <label for="d-direccion">Dirección y localidad<input id="d-direccion" name="direccion" required autocomplete="street-address" /></label>
        <div class="formulario__fila">
          <label for="d-cuit">CUIT o DNI <small>(factura)</small><input id="d-cuit" name="cuit" inputmode="numeric" /></label>
          <label for="d-pago">Forma de pago
            <select id="d-pago" name="pago">
              <option>Transferencia</option>
              <option>Efectivo</option>
              <option>Mercado Pago</option>
            </select>
          </label>
        </div>
        <label for="d-nota">Aclaraciones <small>(horario, timbre, faltantes)</small><textarea id="d-nota" name="nota" rows="2"></textarea></label>
        <label class="casilla" for="d-mensual"><input type="checkbox" id="d-mensual" name="mensual" /> <span>Repetir este pedido cada mes <small>(te escribimos antes de cada entrega para confirmar)</small></span></label>
        <p class="formulario__error" id="datos-error" hidden>Completá el negocio y la dirección para poder enviar el pedido.</p>
        <a class="btn btn--whatsapp btn--ancho" id="enviar" href="https://wa.me/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3z"/></svg>
          Enviar pedido por WhatsApp
        </a>
        <button class="btn-texto" type="button" id="copiar">Copiar el pedido</button>
        <button class="btn-texto btn-texto--suave" type="button" id="vaciar">Vaciar pedido</button>
      </form>
    </div>
  </div>
</aside>

<div class="aviso" id="aviso" role="status" aria-live="polite"><span id="aviso-texto"></span><button type="button" data-abrir-pedido>Ver pedido</button></div>
