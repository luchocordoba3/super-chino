---
import type { Ficha } from "../lib/catalogo";
import { ESTADOS, fechaCorta, pesos, rutaProducto } from "../lib/catalogo";
import Pictograma from "./Pictograma.astro";
import Cantidad from "./Cantidad.astro";
import Monto from "./Monto.astro";
interface Props { p: Ficha }
const { p } = Astro.props;
const o = p.ofertaVigente;
---
<article class:list={["tarjeta", { "tarjeta--agotada": p.estado === "sin-stock" }]} data-producto={p.codigo} data-rubro={p.rubroId} data-buscar={`${p.codigo} ${p.nombre} ${p.medida}`} data-oferta-hasta={o?.hasta}>
  <a class="etiqueta" href={rutaProducto(p.codigo)} data-rubro-tono={p.rubroId} tabindex="-1" aria-hidden="true">
    <span class="etiqueta__cod">{p.codigo}</span>
    {p.foto ? <img class="etiqueta__foto" src={p.foto} alt="" width="480" height="480" loading="lazy" decoding="async" /> : <Pictograma nombre={p.icono} clase="etiqueta__icono" />}
    <span class:list={["etiqueta__medida", { "etiqueta__medida--larga": p.medida.length >= 7 }]}>{p.medida || " "}{p.unidades && <small>{p.unidades} u.</small>}</span>
    {p.estado ? <span class="marca-estado" data-estado={p.estado}>{ESTADOS[p.estado]}</span> : o && <span class="marca-estado con-oferta" data-estado="oferta">−{o.porcentaje}%</span>}
  </a>
  <div class="tarjeta__cuerpo">
    <a class="tarjeta__nombre" href={rutaProducto(p.codigo)}>{p.titulo}</a>
    <div class="tarjeta__pie">
      <p class="precios">
        <span class="precio-etq">{o ? <><span class="con-oferta">Oferta hasta {fechaCorta(o.hasta)}</span><span class="sin-oferta">Por mayor</span></> : "Por mayor"}</span>
        <span class="sticker"><Monto normal={p.mayorista} oferta={o?.mayorista} /></span>
        <span class="precio-suelto">{o && <s class="con-oferta">{pesos(p.mayorista)}</s>} Suelto <Monto normal={p.minorista} oferta={o?.minorista} /></span>
      </p>
      {p.estado === "sin-stock" ? <span class="agotado">Sin stock</span> : <Cantidad codigo={p.codigo} />}
    </div>
  </div>
</article>
