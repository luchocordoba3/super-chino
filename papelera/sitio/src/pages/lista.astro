---
import Base from "../layouts/Base.astro";
import Pictograma from "../components/Pictograma.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import Renglon from "../components/Renglon.astro";
import { NEGOCIO, PRODUCTOS, RUBROS, pesos, ruta } from "../lib/catalogo";
const grupos = RUBROS.map((r) => ({ ...r, productos: PRODUCTOS.filter((p) => p.rubroId === r.id) }));
---
<Base titulo="Lista de precios" camino="lista" seccion="lista" descripcion={`Lista de precios por mayor de ${PRODUCTOS.length} artículos de limpieza, bolsas, papel, descartables y embalaje. Reparto propio en ${NEGOCIO.zona}.`}>
  <div class="envoltura">
    <header class="seccion__cabeza seccion__cabeza--fila" style="padding-top:clamp(2rem,5vw,3.5rem);margin-bottom:1rem">
      <div>
        <p class="sobretitulo">Lista de precios · precios finales con IVA</p>
        <h1 class="titular">Catálogo completo</h1>
      </div>
      <p class="bajada" style="max-width:28rem"><strong style="color:var(--tinta)">Precio por mayor</strong> en pedidos desde {pesos(NEGOCIO.minimoMayorista)}. Debajo de ese monto rige el precio suelto.</p>
    </header>

    <div class="catalogo">
      <div class="catalogo__principal">
        <div class="filtros">
          <div class="filtros__fila">
            <label class="buscador" for="buscar">
              <span class="visualmente-oculto">Buscar producto</span>
              <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2" /><path d="M13 13l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
              <input id="buscar" type="search" placeholder="Buscar: consorcio, 5 L, servilleta, PB0102…" autocomplete="off" />
            </label>
            <div class="vistas" role="group" aria-label="Vista">
              <button type="button" data-vista="grilla" aria-pressed="true" aria-label="Ver en grilla"><svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 2h7v7H2zM11 2h7v7h-7zM2 11h7v7H2zM11 11h7v7h-7z" /></svg></button>
              <button type="button" data-vista="lista" aria-pressed="false" aria-label="Ver como lista"><svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M2 3h16v2.5H2zM2 8.75h16v2.5H2zM2 14.5h16V17H2z" /></svg></button>
            </div>
          </div>
          <div class="chips" role="group" aria-label="Filtrar por rubro">
            <button class="chip chip--todo" type="button" data-filtro="" aria-pressed="true">Todo <span>{PRODUCTOS.length}</span></button>
            {grupos.map((g) => (
              <button class="chip" type="button" data-filtro={g.id} aria-pressed="false"><span class="chip__icono"><Pictograma nombre={g.icono} /></span>{g.corto} <span>{g.productos.length}</span></button>
            ))}
          </div>
        </div>

        <div id="vista-grilla">
          {grupos.map((g) => (
            <section class="grupo" data-grupo={g.id} aria-labelledby={`g-${g.id}`}>
              <div class="grupo-titulo"><h2 id={`g-${g.id}`}>{g.corto}</h2><small data-cuenta>{g.productos.length} artículos</small></div>
              <div class="grilla-productos">
                {g.productos.map((p) => <TarjetaProducto p={p} />)}
              </div>
            </section>
          ))}
        </div>

        <div id="vista-lista" hidden>
          <div class="renglones-cabeza" aria-hidden="true">
            <span></span><span>Código</span><span>Artículo</span><span>Medida</span><span class="num">Por mayor</span><span class="num">Suelto</span><span class="num">Cantidad</span>
          </div>
          {grupos.map((g) => (
            <section class="grupo" data-grupo={g.id} aria-label={g.corto}>
              <div class="grupo-titulo"><h2>{g.corto}</h2><small data-cuenta>{g.productos.length} artículos</small></div>
              {g.productos.map((p) => <Renglon p={p} />)}
            </section>
          ))}
        </div>

        <div class="vacio" id="vacio" hidden>
          <p><strong>No encontramos artículos con esa búsqueda.</strong></p>
          <p>Probá con otra palabra o escribinos: muchas veces lo conseguimos para la próxima entrega.</p>
        </div>
        <p class="bajada" style="font-size:.82rem;margin-block:2rem 4rem">Precios finales con IVA incluido. Sujetos a cambio sin previo aviso; el precio se confirma al aceptar el pedido.</p>
      </div>

      <aside class="resumen" aria-label="Resumen del pedido">
        <div class="resumen__cabeza"><p>Tu pedido</p><span class="resumen__detalle" data-pedido="articulos"></span></div>
        <p class="resumen__total" data-pedido="total">$ 0</p>
        <div class="umbral" data-pedido="umbral" hidden>
          <p class="umbral__texto" data-pedido="umbral-texto"></p>
          <div class="umbral__barra"><span data-pedido="umbral-barra"></span></div>
        </div>
        <p class="resumen__detalle" data-pedido="si-vacio">Cargá cantidades en la lista o sumá un kit desde el inicio.</p>
        <button class="btn btn--tinta btn--ancho" type="button" data-abrir-pedido data-pedido="si-hay" hidden>Revisar y enviar</button>
        <div class="resumen__ayuda">
          <p>¿Ya sabés los códigos?</p>
          <a class="flecha" href={ruta("pedido-rapido")}>Pedido rápido →</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  const norm = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const items = [...document.querySelectorAll<HTMLElement>("[data-buscar]")].map((el) => ({ el, txt: norm(el.dataset.buscar!), rubro: el.dataset.rubro! }));
  const grupos = [...document.querySelectorAll<HTMLElement>("[data-grupo]")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
  const buscar = document.getElementById("buscar") as HTMLInputElement;
  let rubro = "";

  function filtrar() {
    const q = norm(buscar.value.trim()).split(/\s+/).filter(Boolean);
    let visibles = 0;
    for (const it of items) {
      const ok = (!rubro || it.rubro === rubro) && q.every((t) => it.txt.includes(t));
      it.el.hidden = !ok;
      if (ok) visibles++;
    }
    for (const g of grupos) {
      const n = g.querySelectorAll("[data-buscar]:not([hidden])").length;
      g.hidden = n === 0;
      const c = g.querySelector("[data-cuenta]");
      if (c) c.textContent = `${n} artículos`;
    }
    document.getElementById("vacio")!.hidden = visibles > 0;
  }

  function elegir(id: string) {
    rubro = id;
    chips.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.filtro === id)));
    filtrar();
  }

  chips.forEach((c) => c.addEventListener("click", () => {
    elegir(c.dataset.filtro!);
    try { history.replaceState(null, "", rubro ? `#${rubro}` : location.pathname); } catch { /* sin historial */ }
  }));
  let espera: ReturnType<typeof setTimeout>;
  buscar.addEventListener("input", () => {
    clearTimeout(espera);
    espera = setTimeout(() => { if (buscar.value.trim() && rubro) elegir(""); else filtrar(); }, 110);
  });

  const vistas = [...document.querySelectorAll<HTMLButtonElement>("[data-vista]")];
  function vista(v: string) {
    vistas.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.vista === v)));
    document.getElementById("vista-grilla")!.hidden = v !== "grilla";
    document.getElementById("vista-lista")!.hidden = v !== "lista";
    try { localStorage.setItem("doblehoja-vista", v); } catch { /* sin almacenamiento */ }
  }
  vistas.forEach((b) => b.addEventListener("click", () => vista(b.dataset.vista!)));
  try { const v = localStorage.getItem("doblehoja-vista"); if (v) vista(v); } catch { /* sin almacenamiento */ }

  const inicial = location.hash.replace("#", "");
  if (chips.some((c) => c.dataset.filtro === inicial)) elegir(inicial);
</script>
